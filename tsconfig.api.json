{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "types": ["node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Node's own ESM resolution, which is how the platform runs these files:
       each file in api/ is compiled to a .js neighbour and Node resolves the
       specifiers at runtime, so every relative import has to name its file.
       Leaving this as bundler resolution is what let an extensionless import
       ship and take down every /api/auth/* route with ERR_MODULE_NOT_FOUND. */
    "moduleResolution": "nodenext",
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Auth code handles personal data, so it is typechecked strictly
       even though the app project leaves strict mode off. */
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
